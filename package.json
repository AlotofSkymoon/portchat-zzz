{
  "name": "portchat",
  "version": "1.0.0",
  "private": true,
  "description": "Agnes AI 免费聊天 —— 极简纯文本聊天站（Next.js 14 App Router）",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "echo \"已迁移：Next 16 移除了 next lint，请直接用 eslint / biome\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "opennextjs-cloudflare && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:d1:init": "wrangler d1 execute agnes-chat-db --file=./schema.sql --remote",
    "cf:d1:token": "node scripts/gen-d1-token.mjs",
    "cf:secret": "wrangler secret bulk .dev.vars",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@upstash/redis": "1.34.3",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "highlight.js": "11.10.0",
    "lucide-react": "0.454.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.0",
    "remark-gfm": "4.0.0",
    "server-only": "0.0.1",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.0.0",
    "@opennextjs/cloudflare": "^1.20.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "wrangler": "^4.0.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "engines": {
    "node": "22.x"
  }
}
